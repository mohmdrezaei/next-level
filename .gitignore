# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# alternate Next build-output dirs.
#
# `.build` is a symlink to a scratch dir OUTSIDE the project root, used when the
# sandbox cannot delete `.next` (see `.build-check.log`). Turbopack refuses to
# depend on paths outside the root, and Tailwind's automatic source detection
# follows `.gitignore` — so these MUST stay listed here or `next dev` fails with
# "Cannot depend on path ... outside of root directory".
/.build/
/.next-live/
/.next-verify/
/.rt_root/

# production
/build

# misc
.DS_Store
*.pem

# local install logs
install.out.log
install.err.log
.pnpm-install.out.log
.pnpm-install.err.log
pnpm-install.out.log
pnpm-install.err.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
